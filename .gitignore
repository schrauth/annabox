# PlatformIO build artifacts
.pio/
.pioenvs/
.piolibdeps/

# VS Code (keep workspace noise out)
.vscode/*
!.vscode/extensions.json

# IntelliSense / C++ tooling
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/ipch/

# Debug / launch configs (often user- or board-specific)
.vscode/launch.json

# Compiled binaries and maps
*.elf
*.bin
*.hex
*.map

# Logs and temp files
*.log
*.tmp
*.bak

# OS cruft
.DS_Store
Thumbs.db